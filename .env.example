# ─── LLM API Keys (set whichever provider you use) ───
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here

# Optional: for other providers
# ANTHROPIC_API_KEY=your-anthropic-key-here
# MISTRAL_API_KEY=your-mistral-key-here

# ─── Search API Keys (priority: Tavily → Serper → DuckDuckGo fallback) ───
# Tavily — best for AI agents, 1000 free searches/month (https://tavily.com)
TAVILY_API_KEY=tvly-your-key-here

# Serper.dev — Google SERP results, 2500 free queries (https://serper.dev)
# SERPER_API_KEY=your-serper-key-here
